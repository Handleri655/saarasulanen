---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import { site } from "../data/site";
import { organizationNode, serializeGraph, websiteNode } from "../lib/jsonld";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, jsonLd = [] } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, site.url).href;
const graph = serializeGraph([organizationNode(), websiteNode(), ...jsonLd]);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fi" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0F1115" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Saara Sulanen Oy – keraamisten pinnoitusten spesialisti" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.url}/og.png`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={graph} />
  </head>
  <body>
    <a class="skip" href="#sisalto">Siirry sisältöön</a>
    <Header />
    <main id="sisalto">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <div class="h-14 md:hidden" aria-hidden="true"></div>
    <script>
      import { animate, hover, press } from "motion";

      const buttons = ".btn, button, .mobile-bar a";
      const pressed = new WeakSet<Element>();
      const hovered = new WeakSet<Element>();
      const spring = { type: "spring" as const, stiffness: 520, damping: 28, mass: 0.55 };

      const settle = (element: Element) => {
        const scale = pressed.has(element) ? 0.96 : hovered.has(element) ? 1.035 : 1;
        animate(element, { scale }, spring);
      };

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        hover(buttons, (element) => {
          hovered.add(element);
          settle(element);
          return () => {
            hovered.delete(element);
            settle(element);
          };
        });

        press(buttons, (element) => {
          pressed.add(element);
          settle(element);
          return () => {
            pressed.delete(element);
            settle(element);
          };
        });
      }
    </script>
  </body>
</html>
