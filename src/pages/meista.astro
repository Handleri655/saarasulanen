---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import GapText from "../components/GapText.astro";
import { site, companyBlurb, mapsEmbed, mapsLink, mapsQuery } from "../data/site";
import { goals, sharedNotes } from "../data/process";
import { breadcrumbNode } from "../lib/jsonld";

const crumbs = [
  { name: "Etusivu", href: "/" },
  { name: "Meistä", href: "/meista/" },
];

const title = "Meistä | Saara Sulanen Oy, Perniö";
const description =
  "Saara Sulanen Oy on vuonna 2022 Perniöön perustettu keraamisten pinnoitusten tekijä. Suojaamme työkoneita ja raskasta kalustoa ympäri Suomen.";
---

<Base
  title={title}
  description={description}
  jsonLd={[
    breadcrumbNode(crumbs),
    {
      "@type": "AboutPage",
      url: `${site.url}/meista/`,
      name: "Meistä",
      mainEntity: { "@id": `${site.url}/#yritys` },
    },
  ]}
>
  <PageHero eyebrow="Yritys" title="Meistä" crumbs={crumbs}>
    <p>{companyBlurb}</p>
  </PageHero>

  <div class="shell grid gap-10 py-14 lg:grid-cols-[0.8fr_1.2fr]">
    <figure class="border border-line bg-panel">
      <div class="grid aspect-[4/5] place-items-center p-6 text-center">
        <GapText text="[TÄYDENNÄ: kuva yrittäjästä]" />
      </div>
      <figcaption class="border-t border-line p-4 text-sm text-mist">Kuva lisätään, kun se on käytettävissä.</figcaption>
    </figure>
    <div>
      <h2 class="display text-4xl">Mihin työ tähtää</h2>
      <p class="mt-4 text-mist">
        Nämä neljä tavoitetta ovat yrityksen omasta kuvauksesta. Tarkempi esittely lisätään kuvan ja taustatietojen kanssa.
      </p>
      <p class="mt-3">
        <GapText text="[TÄYDENNÄ: yrittäjän tausta]" />
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          goals.map((goal) => (
            <li class="border border-line p-4">
              <h3 class="display text-2xl">{goal.title}</h3>
              <p class="mt-2 text-sm text-mist">{goal.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="shell grid items-center gap-10 pb-16 lg:grid-cols-2">
    <figure class="order-2 border border-line bg-panel lg:order-1">
      <iframe
        title={`Kartta: ${mapsQuery}`}
        src={mapsEmbed}
        class="aspect-[4/3] w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <figcaption class="border-t border-line p-4 text-sm text-mist">
        <p>{site.address.street}, {site.address.postalCode} {site.address.city.toLocaleUpperCase("fi")}</p>
        <a class="mt-2 inline-block text-paper no-underline hover:text-brand" href={mapsLink} target="_blank" rel="noopener noreferrer">
          Avaa Google Mapsissa<span class="sr-only"> (avautuu uuteen välilehteen)</span>
        </a>
      </figcaption>
    </figure>
    <div class="order-1 lg:order-2">
      <h2 class="display text-4xl">Toimipaikka</h2>
      <p class="mt-4 text-mist"><GapText text={sharedNotes.where} /></p>
      <dl class="mt-6 grid gap-3 text-sm">
        <div class="grid grid-cols-[9rem_1fr] gap-3 border-b border-line py-2">
          <dt class="text-mist">Perustettu</dt>
          <dd>{site.founded}</dd>
        </div>
        <div class="grid grid-cols-[9rem_1fr] gap-3 border-b border-line py-2">
          <dt class="text-mist">Y-tunnus</dt>
          <dd>{site.businessId}</dd>
        </div>
        <div class="grid grid-cols-[9rem_1fr] gap-3 border-b border-line py-2">
          <dt class="text-mist">Toimiala</dt>
          <dd>{site.industry}</dd>
        </div>
        <div class="grid grid-cols-[9rem_1fr] gap-3 border-b border-line py-2">
          <dt class="text-mist">Osoite</dt>
          <dd>
            {site.address.street}, {site.address.postalCode} {site.address.city}
          </dd>
        </div>
      </dl>
    </div>
  </div>
  <CtaBand />
</Base>
