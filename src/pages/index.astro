---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
import FinlandMap from "../components/FinlandMap.astro";
import { site } from "../data/site";
import { gallery } from "../data/gallery";

const benefits = [
  {
    title: "Puhtaanapito helpottuu",
    text: "Pinnoite muodostaa koneen ulkopinnoille kovan, lasimaisen kerroksen, jonka ansiosta lika ei pinty kuten suoraan huokoiseen maalipintaan. Pinnoitteen hydrofobiset ominaisuudet vähentävät epäpuhtauksien kertymistä pinnoille.",
  },
  {
    title: "Kemikaali- ja UV-suoja",
    text: "Pinnoite tarjoaa erinomaisen suojan kemikaaleja, hapettumista, auringon UV-säteilyä sekä muita epäpuhtauksia vastaan.",
  },
  {
    title: "Fyysinen suoja",
    text: "Pinnoitteen antama vahva fyysinen suoja perustuu sen asennustapaan ja itse tuotteen ominaisuuksiin. Pinnoite levitetään ruiskuttamalla, jolloin sitä saadaan myös ahtaisiin väleihin, kuten kaivinkoneen puomistoon.",
  },
];

const title = "Ratkaisu koneiden puhtaanapitoon ja suojaukseen | Saara Sulanen";
const description =
  "Tarjoamme työkoneiden, raskaan kaluston ja oheislaitteiden pinnoituspalveluita ympäri Suomea. Ceramic Pro Strong helpottaa puhtaanapitoa ja suojaa pintaa.";
---

<Base title={title} description={description}>
  <section class="home-hero">
    <div class="home-hero-slides">
      <img
        class="home-hero-shot is-shown"
        src="/kuvat/hero-volvo.jpg"
        alt=""
        width="1280"
        height="720"
        fetchpriority="high"
      />
      <img class="home-hero-shot" src="/kuvat/hero-ponsse.jpg" alt="" width="1280" height="720" />
      <img class="home-hero-shot" src="/kuvat/hero-fendt.jpg" alt="" width="1280" height="720" />
      <img class="home-hero-shot" src="/kuvat/hero-hyundai.jpg" alt="" width="1280" height="720" />
    </div>
    <div class="home-hero-shade" aria-hidden="true"></div>
    <div class="shell">
      <p class="home-hero-kicker">Ceramic Pro Strong</p>
      <h1>
        <span>Ratkaisu koneiden helpompaan puhtaanapitoon</span>
        <span>ja suojaukseen ulkoisilta tekijöiltä</span>
      </h1>
      <div class="hero-actions">
        <a class="btn btn-quote" href="#yhteydenotto">Pyydä tarjous</a>
        <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>Soita {site.phoneDisplay}</a>
      </div>
    </div>
  </section>

  <section class="statement" aria-labelledby="esittely">
    <div class="shell statement-layout">
      <div>
        <p class="eyebrow">Tietoa meistä</p>
        <h2 id="esittely" class="display wrap-normal mt-4">
          Tarjoamme työkoneiden, raskaan kaluston ja oheislaitteiden pinnoituspalveluita ympäri Suomea.
        </h2>
      </div>
      <figure class="finland-map">
        <FinlandMap />
        <figcaption>Koko Suomi</figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-16" aria-labelledby="kuvat">
    <div class="shell">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <h2 id="kuvat" class="display text-4xl sm:text-5xl">Kuvia laitteista</h2>
          <p class="mt-3 max-w-xl text-mist">Valokuvat on julkaistu yrityksen Facebook-sivulla.</p>
        </div>
        <a class="btn btn-line" href="/palvelut/#kuvat">Kaikki kuvat</a>
      </div>
    </div>
    <div class="marquee mt-8">
      <div class="marquee-track">
        {
          [false, true].map((hidden) => (
            <div class="marquee-group" aria-hidden={hidden ? "true" : undefined}>
              {gallery.map((item) => (
                <a href="/palvelut/#kuvat" tabindex={hidden ? -1 : undefined}>
                  <img
                    src={item.src}
                    alt={hidden ? "" : item.alt}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                  />
                  <p class="mt-2 text-sm">{item.title}</p>
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band-dark py-16 lg:py-20" aria-labelledby="hyodyt">
    <div class="shell">
      <h2 id="hyodyt" class="display max-w-3xl text-4xl sm:text-5xl">Pinnoitteen tarjoamat hyödyt</h2>
      <div class="mt-10 grid gap-8 lg:grid-cols-3">
        {
          benefits.map((benefit) => (
            <article class="border-t border-[#e5e5e5] pt-4">
              <h3 class="display text-3xl">{benefit.title}</h3>
              <p class="mt-3 text-mist">{benefit.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-[#f3f3f3] py-16" id="yhteydenotto" aria-labelledby="lomake">
    <div class="shell grid items-start gap-10 lg:grid-cols-[0.75fr_1.25fr]">
      <div>
        <h2 id="lomake" class="display text-4xl sm:text-5xl">Yhteydenotto</h2>
        <p class="mt-4 text-mist">
          Kerro kalusto ja paikkakunta. Saat hinnan ennen kuin työhön ryhdytään. Voit myös soittaa numeroon {site.phoneDisplay}.
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>(".home-hero-shot")];
  const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (slides.length > 1 && !motion.matches) {
    let index = 0;
    let timer = 0;

    const show = (next: number) => {
      slides[index].classList.remove("is-shown");
      index = next;
      slides[index].classList.add("is-shown");
    };

    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => show((index + 1) % slides.length), 8500);
    };

    start();
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) window.clearInterval(timer);
      else start();
    });
  }
</script>
