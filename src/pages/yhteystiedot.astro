---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import ContactForm from "../components/ContactForm.astro";
import GapText from "../components/GapText.astro";
import { site } from "../data/site";
import { breadcrumbNode } from "../lib/jsonld";

const crumbs = [
  { name: "Etusivu", href: "/" },
  { name: "Yhteystiedot", href: "/yhteystiedot/" },
];

const title = "Pyydä tarjous pinnoituksesta | Saara Sulanen";
const description =
  "Pyydä tarjous keraamisesta pinnoituksesta. Soita 050 351 4657 tai lähetä lomake.";
---

<Base
  title={title}
  description={description}
  jsonLd={[
    breadcrumbNode(crumbs),
    {
      "@type": "ContactPage",
      url: `${site.url}/yhteystiedot/`,
      name: "Pyydä tarjous",
      mainEntity: { "@id": `${site.url}/#yritys` },
    },
  ]}
>
  <PageHero eyebrow="Yhteys" title="Pyydä tarjous" crumbs={crumbs} image="/kuvat/hero-volvo.jpg">
    <p>Kerro kalusto ja paikkakunta. Saat hinnan ennen päätöstä. Voit myös soittaa tai laittaa sähköpostia.</p>
  </PageHero>

  <section class="border-b border-line" aria-labelledby="miksi">
    <div class="shell py-14">
      <h2 id="miksi" class="display text-4xl sm:text-5xl">Miksi meidät</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          ["Asiakaslähtöisyys", "Laatu edellä", "Luotettava toteutus"].map((item) => (
            <li class="border-t-2 border-brand pt-4">
              <p class="display text-3xl">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="shell grid gap-12 py-14 lg:grid-cols-[1.15fr_0.85fr]">
    <ContactForm />
    <aside class="soft-card h-fit p-6">
      <h2 class="display text-3xl">Saara Sulanen Oy</h2>
      <address class="mt-4 not-italic">
        <p>{site.address.city}</p>
        <p class="mt-4">
          <a class="text-brand no-underline" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </p>
        <p>
          <a class="text-brand no-underline" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </address>
      <p class="mt-4 text-sm text-mist">Y-tunnus {site.businessId}</p>
      <p class="mt-4">
        <GapText text="[TÄYDENNÄ: aukioloajat]" />
      </p>
      <ul class="mt-6 flex gap-4 text-sm font-semibold">
        <li>
          <a class="no-underline hover:text-brand" href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
        </li>
        <li>
          <a class="no-underline hover:text-brand" href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </li>
      </ul>
    </aside>
  </div>

</Base>
