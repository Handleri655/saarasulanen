---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import CtaBand from "../components/CtaBand.astro";
import { gallery, galleryFilters } from "../data/gallery";
import { breadcrumbNode } from "../lib/jsonld";

const crumbs = [
  { name: "Etusivu", href: "/" },
  { name: "Referenssit", href: "/referenssit/" },
];

const title = "Referenssit ja kuvagalleria | Saara Sulanen";
const description =
  "Työkuvia pyöräkuormaajasta, kuormatraktorista, kaivinkoneesta ja kuorma-autosta. Kuvat on julkaistu Saara Sulanen Oy:n Facebookissa.";
---

<Base title={title} description={description} jsonLd={[breadcrumbNode(crumbs)]}>
  <PageHero eyebrow="Galleria" title="Referenssit" crumbs={crumbs}>
    <p>
      Kuvat on julkaistu Saara Sulanen Oy:n Facebook-sivulla. Pyöräkuormaajan kuvasarja on merkitty sijaintiin Piikkiö.
    </p>
  </PageHero>

  <div class="shell py-14">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Suodata kaluston mukaan">
      {
        galleryFilters.map((filter) => (
          <button class="filter-btn" type="button" data-filter={filter.id} aria-pressed={filter.id === "kaikki" ? "true" : "false"}>
            {filter.label}
          </button>
        ))
      }
    </div>
    <p class="mt-4 text-sm text-mist" aria-live="polite" data-count>
      {gallery.length} kohdetta
    </p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-gallery>
      {
        gallery.map((item) => (
          <article class="border border-line bg-ink" data-category={item.category}>
            <img
              src={item.src}
              alt={item.alt}
              width={item.width}
              height={item.height}
              class="aspect-[3/4] w-full object-cover"
              loading="lazy"
            />
            <div class="p-5">
              <p class="eyebrow">{item.categoryLabel}</p>
              <h2 class="display wrap-normal mt-2 text-2xl">{item.title}</h2>
              <p class="mt-3 text-sm text-mist">{item.caption}</p>
            </div>
          </article>
        ))
      }
    </div>
    <p class="mt-6 hidden text-mist" data-empty>Ei kuvia tässä luokassa.</p>

    <h2 class="display mt-16 text-4xl">Havainne pinnasta</h2>
    <p class="mt-3 max-w-2xl text-mist">
      Oikealla on valokuva Volvo L90H -pyöräkuormaajasta. Vasemmalla sama kuva, johon on lisätty mutaa ja pölyä.
    </p>
    <div class="mt-6">
      <BeforeAfter />
    </div>
  </div>
  <CtaBand />
</Base>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
  const count = document.querySelector("[data-count]");
  const empty = document.querySelector("[data-empty]");

  const apply = (filter: string) => {
    let visible = 0;
    cards.forEach((card) => {
      const show = filter === "kaikki" || card.dataset.category === filter;
      card.hidden = !show;
      if (show) visible += 1;
    });
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", button.dataset.filter === filter ? "true" : "false");
    });
    if (count) count.textContent = visible === 1 ? "1 kohde" : `${visible} kohdetta`;
    if (empty instanceof HTMLElement) empty.classList.toggle("hidden", visible !== 0);
    const url = new URL(location.href);
    if (filter === "kaikki") url.searchParams.delete("tyyppi");
    else url.searchParams.set("tyyppi", filter);
    history.replaceState(null, "", url);
  };

  const initial = new URLSearchParams(location.search).get("tyyppi");
  const known = buttons.some((button) => button.dataset.filter === initial);
  apply(known && initial ? initial : "kaikki");

  buttons.forEach((button) => {
    button.addEventListener("click", () => apply(button.dataset.filter || "kaikki"));
  });
</script>
