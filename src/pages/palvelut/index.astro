---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { gallery, galleryFilters } from "../../data/gallery";
import { breadcrumbNode } from "../../lib/jsonld";

const crumbs = [
  { name: "Etusivu", href: "/" },
  { name: "Palvelut", href: "/palvelut/" },
];

const title = "Ceramic Pro Strong -pinnoitus | Saara Sulanen";
const description =
  "Työkoneiden, raskaan kaluston ja oheislaitteiden Ceramic Pro Strong -pinnoitukset ympäri Suomen, asiakkaan tai koneliikkeen tiloissa. Myös lasien tummennukset ja pienet mainosteippaukset.";
---

<Base title={title} description={description} jsonLd={[breadcrumbNode(crumbs)]}>
  <PageHero eyebrow="Palvelut" title="Ceramic Pro Strong" crumbs={crumbs} image="/kuvat/hero-volvo.jpg">
    <p>
      Saara Sulanen Oy tarjoaa ratkaisun koneiden helpompaan puhtaanapitoon ja suojaukseen ulkoisilta tekijöiltä.
    </p>
  </PageHero>

  <section id="ceramic-pro" class="scroll-mt-28">
    <div class="shell py-14">
      <div class="grid max-w-3xl gap-4 text-mist">
        <p>
          Saara Sulanen Oy tarjoaa ratkaisun koneiden helpompaan puhtaanapitoon ja suojaukseen ulkoisilta tekijöiltä.
          Teemme työkoneiden, raskaan kaluston ja oheislaitteiden pinnoitukset ympäri Suomen, asiakkaan tai koneliikkeen tiloissa.
        </p>
        <p>
          Työkoneiden pinnoituksessa käytämme pääasiassa ruiskulla levitettävää Ceramic Pro Strong -pinnoitetta.
          Tuotteen ominaisuuksien sekä asennustavan ansiosta maalipinnalle saadaan noin 15 mikronia paksu suojakalvo.
          Asennustapa mahdollistaa myös vaikeampien välien pinnoituksen, kuten kaivinkoneiden puomiston.
        </p>
      </div>
    </div>
  </section>

  <section id="kuvat" class="scroll-mt-28 bg-[#f3f3f3] py-16" aria-labelledby="kuvat-otsikko">
    <div class="shell">
      <h2 id="kuvat-otsikko" class="display text-4xl sm:text-5xl">Työn kuvia</h2>
      <p class="mt-3 max-w-2xl text-mist">
        Kuvat on julkaistu Saara Sulanen Oy:n Facebook-sivulla. Pyöräkuormaajan kuvasarja on merkitty sijaintiin Piikkiö.
      </p>
      <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Suodata kaluston mukaan">
        {
          galleryFilters.map((filter) => (
            <button class="filter-btn" type="button" data-filter={filter.id} aria-pressed={filter.id === "kaikki" ? "true" : "false"}>
              {filter.label}
            </button>
          ))
        }
      </div>
      <p class="mt-4 text-sm text-mist" aria-live="polite" data-count>
        {gallery.length} kohdetta
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-gallery>
        {
          gallery.map((item) => (
            <article class="border border-line bg-ink text-paper" data-category={item.category}>
              <img
                src={item.src}
                alt={item.alt}
                width={item.width}
                height={item.height}
                class="aspect-[3/4] w-full object-cover"
                loading="lazy"
              />
              <div class="p-5">
                <p class="eyebrow">{item.categoryLabel}</p>
                <h3 class="display wrap-normal mt-2 text-2xl">{item.title}</h3>
                <p class="mt-3 text-sm text-mist">{item.caption}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-6 hidden text-mist" data-empty>Ei kuvia tässä luokassa.</p>
    </div>
  </section>

  <section class="shell grid gap-4 py-16 sm:grid-cols-2" aria-label="Muut palvelut">
    <article id="tummennukset" class="scroll-mt-28 soft-card p-6">
      <h2 class="display text-3xl">Lasien tummennukset</h2>
      <p class="mt-3 text-mist">Kauttamme saat myös lasien tummennukset.</p>
    </article>
    <article id="teippaukset" class="scroll-mt-28 soft-card p-6">
      <h2 class="display text-3xl">Pienet mainosteippaukset</h2>
      <p class="mt-3 text-mist">Kauttamme saat myös pienet mainosteippaukset.</p>
    </article>
  </section>
  <CtaBand />
</Base>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-category]"));
  const count = document.querySelector("[data-count]");
  const empty = document.querySelector("[data-empty]");

  const apply = (filter: string) => {
    let visible = 0;
    cards.forEach((card) => {
      const show = filter === "kaikki" || card.dataset.category === filter;
      card.hidden = !show;
      if (show) visible += 1;
    });
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", button.dataset.filter === filter ? "true" : "false");
    });
    if (count) count.textContent = visible === 1 ? "1 kohde" : `${visible} kohdetta`;
    if (empty instanceof HTMLElement) empty.classList.toggle("hidden", visible !== 0);
  };

  const initial = new URLSearchParams(location.search).get("tyyppi");
  const known = buttons.some((button) => button.dataset.filter === initial);
  apply(known && initial ? initial : "kaikki");

  buttons.forEach((button) => {
    button.addEventListener("click", () => apply(button.dataset.filter || "kaikki"));
  });
</script>
