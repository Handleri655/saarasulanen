---
import type { Faq } from "../data/faq";
import GapText from "./GapText.astro";

interface Props {
  items: Faq[];
}

const { items } = Astro.props;
---

<div class="border-t border-line">
  {
    items.map((item) => (
      <details class="border-b border-line">
        <summary class="flex cursor-pointer items-center justify-between gap-4 py-5">
          <span class="display text-2xl sm:text-3xl">{item.q}</span>
          <span class="faq-icon shrink-0" aria-hidden="true"></span>
        </summary>
        <div class="max-w-3xl pb-6 text-mist">
          <p>{item.a}</p>
          {item.gap && (
            <p class="mt-3">
              <GapText text={`[TÄYDENNÄ: ${item.gap}]`} />
            </p>
          )}
        </div>
      </details>
    ))
  }
</div>
