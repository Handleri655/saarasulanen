---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-brand bg-graphite">
  <div class="shell grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo />
      <p class="mt-4 max-w-xs text-sm text-mist">
        Pinnoituspalveluita työkoneille, raskaalle kalustolle ja oheislaitteille ympäri Suomen.
      </p>
    </div>
    <div>
      <h2 class="eyebrow">Sivut</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        <li><a class="text-paper no-underline hover:text-brand" href="/">Etusivu</a></li>
        <li><a class="text-paper no-underline hover:text-brand" href="/palvelut/">Palvelut</a></li>
        <li><a class="text-paper no-underline hover:text-brand" href="/yritys/">Yritys</a></li>
        <li><a class="text-paper no-underline hover:text-brand" href="/yhteystiedot/">Yhteystiedot</a></li>
      </ul>
    </div>
    <div>
      <h2 class="eyebrow">Palvelut</h2>
      <ul class="mt-4 grid gap-2 text-sm">
        <li><a class="text-paper no-underline hover:text-brand" href="/palvelut/#ceramic-pro">Ceramic Pro Strong</a></li>
        <li><a class="text-paper no-underline hover:text-brand" href="/palvelut/#tummennukset">Lasien tummennukset</a></li>
        <li><a class="text-paper no-underline hover:text-brand" href="/palvelut/#teippaukset">Mainosteippaukset</a></li>
      </ul>
    </div>
    <div>
      <h2 class="eyebrow">Yhteystiedot</h2>
      <address class="mt-4 text-sm not-italic text-paper">
        <p class="font-semibold">{site.name}</p>
        <p>{site.address.city}</p>
        <p class="mt-3">
          <a class="text-paper no-underline hover:text-brand" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </p>
        <p>
          <a class="text-paper no-underline hover:text-brand" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="mt-3 text-mist">Y-tunnus {site.businessId}</p>
        <p class="text-mist">Toimiala: {site.industry}</p>
      </address>
      <ul class="mt-4 flex gap-4 text-sm">
        <li>
          <a class="font-semibold text-paper no-underline hover:text-brand" href={site.facebook} target="_blank" rel="noopener noreferrer">
            Facebook<span class="sr-only"> (avautuu uuteen välilehteen)</span>
          </a>
        </li>
        <li>
          <a class="font-semibold text-paper no-underline hover:text-brand" href={site.instagram} target="_blank" rel="noopener noreferrer">
            Instagram<span class="sr-only"> (avautuu uuteen välilehteen)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="shell flex flex-col gap-2 py-4 text-sm text-mist sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      <p>Ei seurantaevästeitä. <a class="text-paper underline" href="/evasteet/">Evästeseloste</a></p>
    </div>
  </div>
</footer>
