---
import { site } from "../data/site";
---

<div class="mobile-bar fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-line bg-ink/95 backdrop-blur">
  <a class="grid min-h-14 place-items-center font-semibold text-paper no-underline" href={`tel:${site.phoneTel}`}>
    Soita
  </a>
  <a class="mobile-quote flex min-h-14 items-center justify-center gap-2 text-paper no-underline" href="/yhteystiedot/">
    Ota yhteyttä
    <svg class="btn-arrow" viewBox="0 0 20 10" aria-hidden="true">
      <path d="M0 3.6h10.5V1.2L19 5l-8.5 3.8V6.4H0z" fill="currentColor"></path>
    </svg>
  </a>
</div>
