---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function active(href: string) {
  const clean = href.replace(/\/$/, "") || "/";
  return path === clean;
}

const links = [
  { href: "/", label: "Etusivu" },
  { href: "/palvelut/", label: "Palvelut" },
  { href: "/yritys/", label: "Yritys" },
  { href: "/yhteystiedot/", label: "Yhteystiedot" },
];
---

<header class="site-header">
  <div class="shell site-header-row">
    <Logo />
    <nav class="site-nav" aria-label="Päävalikko">
      {
        links.map((link) => (
          <a href={link.href} class:list={["nav-link", active(link.href) && "is-active"]} aria-current={active(link.href) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="site-tools">
      <a class="btn btn-quote" href="/yhteystiedot/">
        Ota yhteyttä
        <svg class="btn-arrow" viewBox="0 0 20 10" aria-hidden="true">
          <path d="M0 3.6h10.5V1.2L19 5l-8.5 3.8V6.4H0z" fill="currentColor"></path>
        </svg>
      </a>
    </div>
    <button type="button" class="menu-btn" aria-haspopup="dialog" aria-expanded="false" data-menu-open>
      <span class="sr-only">Avaa valikko</span>
      <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8"></path>
      </svg>
    </button>
  </div>
</header>

<dialog class="nav-dialog" data-dialog aria-label="Valikko">
  <div class="nav-dialog-bar">
    <Logo />
    <button type="button" class="menu-btn" data-menu-close autofocus>
      <span class="sr-only">Sulje valikko</span>
      <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8"></path>
      </svg>
    </button>
  </div>
  <div class="nav-dialog-scroll">
    <nav aria-label="Mobiilivalikko">
      <ul class="nav-group">
        {
          links.map((link) => (
            <li>
              <a class:list={["nav-row", active(link.href) && "is-active"]} href={link.href} aria-current={active(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav-dialog-actions">
      <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>Soita</a>
      <a class="btn btn-quote" href="/yhteystiedot/">
        Ota yhteyttä
        <svg class="btn-arrow" viewBox="0 0 20 10" aria-hidden="true">
          <path d="M0 3.6h10.5V1.2L19 5l-8.5 3.8V6.4H0z" fill="currentColor"></path>
        </svg>
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector("[data-dialog]");
  const openBtn = document.querySelector("[data-menu-open]");
  const closeBtn = document.querySelector("[data-menu-close]");

  const setExpanded = (open: boolean) => {
    if (openBtn instanceof HTMLButtonElement) openBtn.setAttribute("aria-expanded", open ? "true" : "false");
  };

  openBtn?.addEventListener("click", () => {
    if (dialog instanceof HTMLDialogElement) {
      dialog.showModal();
      setExpanded(true);
    }
  });

  closeBtn?.addEventListener("click", () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  });

  dialog?.addEventListener("close", () => {
    setExpanded(false);
  });

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
  });
</script>
