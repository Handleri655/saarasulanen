---
interface Props {
  tone?: "light" | "dark";
}

const tone = Astro.props.tone ?? "light";
---

<a href="/" class="inline-flex items-center no-underline" aria-label="Saara Sulanen Oy, etusivu">
  <img
    class:list={["logo-mark", tone === "dark" && "is-ink"]}
    src="/logo.png"
    alt=""
    width="960"
    height="958"
  />
</a>

<style>
  .logo-mark {
    height: 4.5rem;
    width: auto;
  }

  .logo-mark.is-ink {
    filter: invert(1);
  }
</style>
