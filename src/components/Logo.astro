---
interface Props {
  tone?: "light" | "dark";
}

const tone = Astro.props.tone ?? "light";
const word = tone === "light" ? "text-paper" : "text-ink";
---

<a href="/" class:list={["flex items-center gap-3 no-underline", word]} aria-label="Saara Sulanen Oy, etusivu">
  <svg viewBox="0 0 48 48" class="h-10 w-10 shrink-0" aria-hidden="true">
    <path
      d="M24 3.5 42 10.2V24c0 10.2-7.4 17.2-18 20.2C13.4 41.2 6 34.2 6 24V10.2z"
      fill="none"
      stroke="#F5B700"
      stroke-width="2.2"></path>
    <path d="M24 14.5c3.6 4.6 5.4 7.6 5.4 11.1a5.4 5.4 0 0 1-10.8 0c0-3.5 1.8-6.5 5.4-11.1z" fill="#F5B700"
    ></path>
    <path d="M22.2 20.2c.7 1.6 1 2.6 1 3.6a1.6 1.6 0 0 1-3.1.5c.2-1.2.8-2.2 2.1-4.1z" fill="#fff" opacity="0.85"
    ></path>
  </svg>
  <span class="leading-none">
    <span class="display block text-[1.55rem] tracking-[0.04em]">Saara Sulanen</span>
    <span class="mt-1 block text-[0.62rem] font-semibold tracking-[0.22em] text-brand">OY</span>
  </span>
</a>
